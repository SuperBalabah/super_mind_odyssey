# Super Mind Odyssey - Environment Variables Template
# Copy this file to .env and fill in your keys. NEVER commit .env to git!

# Google AI Studio Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Groq Cloud API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
